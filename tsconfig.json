{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "types": ["node", "vite/client"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "apps",
    "packages",
    "tests",
    "worker-configuration.d.ts",
    "*.config.ts"
  ]
}
